    "deposit-rates",
    "fdr",
    "dps",
    "interest-rates",
    "soc",
    "bangladesh-bank",
    "fintech-api"
  ],
  "scripts": {
    "dev": "next dev -p 3009",
    "build": "next build",
    "start": "next start -p 3009",
