    {
      "name": "04. Security Gating & Error Resilience",
      "item": [
        {
          "name": "TC-11: Security — Missing API Key Handshake (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rates/deposits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rates",
                "deposits"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () { pm.response.to.have.status(401); });",
                  "pm.test('Error code is UNAUTHORIZED_ACCESS', function () { const json = pm.response.json(); pm.expect(json.code).to.eql('UNAUTHORIZED_ACCESS'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
