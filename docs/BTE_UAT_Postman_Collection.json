    {
      "name": "03. Deposit Matrix & Statutory Taxes",
      "item": [
        {
          "name": "TC-06: 1-Year Baseline ৳500K with e-TIN (10% TDS)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rates/deposits?principal=500000&tenure=1_year&category=ALL&has_tin=true&sort_by=risk_adjusted",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rates",
                "deposits"
              ],
              "query": [
                {
                  "key": "principal",
                  "value": "500000"
                },
                {
                  "key": "tenure",
                  "value": "1_year"
                },
                {
                  "key": "category",
                  "value": "ALL"
                },
                {
                  "key": "has_tin",
                  "value": "true"
                },
                {
                  "key": "sort_by",
                  "value": "risk_adjusted"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Tax is 10% TDS and Excise is ৳500', function () { const json = pm.response.json(); pm.expect(json.query_context.tds_rate_applied).to.eql('10.0%'); pm.expect(json.query_context.statutory_excise_duty_bdt).to.eql(500); });",
                  "pm.test('Top ranked bank best matching scheme has positive net interest', function () { const json = pm.response.json(); pm.expect(json.top_ranked_bank.best_matching_scheme.net_interest_bdt).to.be.above(0); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
